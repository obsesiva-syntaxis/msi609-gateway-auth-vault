    {
      "name": "6. Sesion invalida",
      "description": "Manuales, no automatizables aqui: con 'docker compose stop auth', GET /auth/me con una sesion valida debe responder 503; con 'docker compose stop backend', GET /api/products con sesion valida debe responder 502; con 'docker compose stop vault', cualquier ruta protegida debe responder 503.",
      "item": [
        {
          "name": "6.1 Cookie inventada en /auth/me -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "session_token=valor-inventado-123" }], "url": { "raw": "{{gateway_url}}/auth/me", "host": ["{{gateway_url}}"], "path": ["auth", "me"] } }
        },
        {
          "name": "6.2 Cookie inventada en /api/products -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "session_token=valor-inventado-123" }], "url": { "raw": "{{gateway_url}}/api/products", "host": ["{{gateway_url}}"], "path": ["api", "products"] } }
        },
