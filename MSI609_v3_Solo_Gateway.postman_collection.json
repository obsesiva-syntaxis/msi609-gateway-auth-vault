      ]
    },
    {
      "name": "7. Vault (OPCIONAL, requiere 127.0.0.1:8200)",
      "item": [
        {
          "name": "7.1 Leer secret/gateway -> solo los secretos de servicio",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data.data;",
            "pm.test('contiene backend_shared_secret', () => pm.expect(d).to.have.property('backend_shared_secret'));",
            "pm.test('contiene auth_introspection_secret', () => pm.expect(d).to.have.property('auth_introspection_secret'));",
            "pm.test('ya no existe client_token (se elimino el token estatico)', () => pm.expect(d).to.not.have.property('client_token'));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "X-Vault-Token", "value": "{{vault_token}}" }], "url": { "raw": "{{vault_url}}/v1/secret/data/gateway", "host": ["{{vault_url}}"], "path": ["v1", "secret", "data", "gateway"] } }
        },
